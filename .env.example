# Copie ce fichier en ".env" et garde .env hors de Git.
# .env.example est versionne (il documente les variables attendues),
# .env ne l'est jamais (il contient les vraies valeurs).

POSTGRES_USER=mdp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=marketdata

# Hote et port vus depuis ta machine (pas depuis le conteneur)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
